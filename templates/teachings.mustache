{{!
    @template block_apsolu_dashboard/teachings

    Template Moodle pour afficher l'onglet d'enseignements sur la tableau de bord.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * wwwroot
    * is_siuaps_rennes
    * shnu
    * pendingenrolments
    * teaching_preferences
    * teachings
       * courses
          * id
          * fullname
          * visible
          * enrolid
          * name
          * customchar1
          * courseid
          * customint7
          * customint8
          * roleid
          * has_many_enrolments
        * enrolments
          * id
          * name
       * count_courses

    Example context (json):
    {
        "wwwroot": "https://apsolu.fr",
        "is_siuaps_rennes": false,
        "shnu": false,
        "pendingenrolments": [],
        "teaching_preferences": {},
        "teachings": []
    }
}}

<div class="text-end">
    <a aria-expanded="false" class="dropdown-toggle px-2" data-bs-toggle="dropdown" href="#" role="button"><i aria-hidden="true" class="fa fa-filter fa-fw icon mx-1 navicon"></i>{{#str}}display, block_apsolu_dashboard{{/str}}</a>

    <div class="dropdown-menu m-0 p-0">
        <form action="{{wwwroot}}/blocks/apsolu_dashboard/preferences.php" class="m-1 px-3 py-2" method="post">
            <div class="form-check">
                <label><input {{#teaching_preferences.block_apsolu_dashboard_teachings_display_upcoming_courses}}checked {{/teaching_preferences.block_apsolu_dashboard_teachings_display_upcoming_courses}}class="form-check-input" name="block_apsolu_dashboard_teachings_display_upcoming_courses" value="1" type="checkbox">{{#str}}show_upcoming_courses, block_apsolu_dashboard{{/str}}</label>
            </div>
            <div class="form-check">
                <label><input {{#teaching_preferences.block_apsolu_dashboard_teachings_display_past_courses}}checked {{/teaching_preferences.block_apsolu_dashboard_teachings_display_past_courses}}class="form-check-input" name="block_apsolu_dashboard_teachings_display_past_courses" value="1" type="checkbox">{{#str}}show_past_courses, block_apsolu_dashboard{{/str}}</label>
            </div>
            <div class="form-check">
                <label><input {{#teaching_preferences.block_apsolu_dashboard_teachings_display_hidden_courses}}checked {{/teaching_preferences.block_apsolu_dashboard_teachings_display_hidden_courses}}class="form-check-input" name="block_apsolu_dashboard_teachings_display_hidden_courses" value="1" type="checkbox">{{#str}}show_hidden_courses, block_apsolu_dashboard{{/str}}</label>
            </div>
            <div class="dropdown-divider"></div>
            <div class="form-check">
                <label class="d-block"><input {{#teaching_preferences.block_apsolu_dashboard_teachings_sort_order_name}}checked {{/teaching_preferences.block_apsolu_dashboard_teachings_sort_order_name}}class="form-check-input" name="block_apsolu_dashboard_teachings_sort_order" value="name" type="radio">{{#str}}sort_by_activity_then_in_chronological_order, block_apsolu_dashboard{{/str}}</label>
                <label class="d-block"><input {{#teaching_preferences.block_apsolu_dashboard_teachings_sort_order_time}}checked {{/teaching_preferences.block_apsolu_dashboard_teachings_sort_order_time}}class="form-check-input" name="block_apsolu_dashboard_teachings_sort_order" value="time" type="radio">{{#str}}sort_in_chronological_order_then_by_activity, block_apsolu_dashboard{{/str}}</label>
            </div>
            <div class="dropdown-divider"></div>
            <div class="text-end">
                <button class="btn btn-primary btn-sm" type="submit">{{#str}}save{{/str}}</button>
            </div>
      </form>
    </div>
</div>

<ul class="list-inline">
    <li class="list-inline-item"><a id="apsolu-dashboard-search-students" class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/blocks/apsolu_dashboard/extractions.php">{{#str}}my_students, block_apsolu_dashboard{{/str}}</a></li>

    {{#is_siuaps_rennes}}
    {{#shnu}}
    <li class="list-inline-item"><a id="apsolu-dashboard-search-shnu" class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/blocks/apsolu_dashboard/shnu.php">{{#str}}my_shnu, block_apsolu_dashboard{{/str}}</a></li>
    {{/shnu}}
    {{/is_siuaps_rennes}}

    {{#ffsu}}
    <li class="list-inline-item"><a id="apsolu-dashboard-search-ffsu" class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/local/apsolu/federation/listing/index.php">{{#str}}federation_list, local_apsolu{{/str}}</a></li>
    {{/ffsu}}

    {{#grading}}
<li class="list-inline-item"><a id="apsolu-dashboard-search-grades" class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/local/apsolu/grades/grade/index.php">{{#str}}grades{{/str}}</a></li>
    {{/grading}}

    {{#pendingenrolments}}
    <li class="list-inline-item"><a id="apsolu-dashboard-search-pendingenrolments" class="btn btn-sm btn-warning" href="{{wwwroot}}/blocks/apsolu_dashboard/pendingenrolments.php">{{#str}}pending_enrolments, block_apsolu_dashboard{{/str}} ({{pendingenrolments}})</a></li>
    {{/pendingenrolments}}
    {{^pendingenrolments}}
    <li class="list-inline-item"><a id="apsolu-dashboard-search-pendingenrolments" class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/blocks/apsolu_dashboard/pendingenrolments.php">{{#str}}pending_enrolments, block_apsolu_dashboard{{/str}}</a></li>
    {{/pendingenrolments}}
</ul>

<ul class="mb-2 nav nav-tabs" role="tablist">
    {{#teachings}}
    <li class="nav-item">
        <a aria-controls="teachings-{{ shortname }}" aria-selected="true" class="nav-link{{#active}} active{{/active}}" data-bs-toggle="tab" href="#teachings-{{ shortname }}" id="teachings-{{ shortname }}-tab" role="tab">{{ name }}</a>
    </li>
    {{/teachings}}
</ul>

<div class="tab-content">
    {{#teachings}}
    <div id="teachings-{{ shortname }}" class="tab-pane show{{#active}} active{{/active}}" role="tabpanel" aria-labelledby="teachings-{{ shortname }}-tab">
        {{^count_courses}}
        <p class="alert alert-info">{{#str}}no_courses, block_apsolu_dashboard{{/str}}</p>
        {{/count_courses}}

        {{#count_courses}}
        <ul class="list-unstyled list-group">
            {{#courses}}
            <li class="list-group-item list-group-item-action">
                <p class="pull-left"><a {{^visible}}class="text-muted" {{/visible}}href="{{wwwroot}}/course/view.php?id={{id}}">{{fullname}}</a></p>
                {{#enrolid}}
                <ul class="list-inline pull-right">
                    <li class="list-inline-item"><a class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/enrol/select/manage.php?courseid={{id}}">{{#str}}enrol_users, block_apsolu_dashboard{{/str}}</a></li>
                    <li class="list-inline-item">
                        <div class="btn-group">
                            <a class="btn btn-sm btn-default btn-secondary" href="{{wwwroot}}/enrol/select/export.php?enrolid={{enrolid}}&format=xls">{{#str}}export, block_apsolu_dashboard{{/str}}</a>
                            {{#has_many_enrolments}}
                            <button type="button" class="btn btn-sm btn-default btn-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="visually-hidden">Toggle Dropdown</span>
                            </button>
                            <div class="apsolu-dropdown-menu dropdown-menu dropdown-menu-end">
                                {{#enrolments}}
                                    <a class="dropdown-item" href="{{wwwroot}}/enrol/select/export.php?enrolid={{id}}&format=xls">{{name}}</a>
                                {{/enrolments}}
                            </div>
                            {{/has_many_enrolments}}
                        </div>
                    </li>
                </ul>
                {{/enrolid}}
            </li>
            {{/courses}}
        </ul>
        {{/count_courses}}
    </div>
    {{/teachings}}
</div>
